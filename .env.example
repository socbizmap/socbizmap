# Copy to `.env` locally. Never commit real keys (especially not service_role).
# Web beta (Vercel / Cloudflare Pages / GitHub Actions): set the same names as
# **build** env — Expo inlines EXPO_PUBLIC_* at `npx expo export -p web`. See docs/WEB.md.
# Without both URL + ANON_KEY the app uses the in-memory/AsyncStorage mock.

# Project host: mutfwhenuegvdwhgwnty.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://mutfwhenuegvdwhgwnty.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Show email magic-link on login (also auto-shown if SMS send fails).
# Phone SMS needs Twilio Trust Hub KYC; Free Auth templates are ConfirmationURL-only.
EXPO_PUBLIC_AUTH_EMAIL=

# Only if custom SMTP or Pro lets you put {{ .Token }} in the Magic Link template.
EXPO_PUBLIC_AUTH_EMAIL_OTP=
